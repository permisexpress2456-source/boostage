# Environment Configuration for Kamiboost SMM Panel
# Copy this file to .env.local and update the values

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# Database Configuration (if using database sessions)
DATABASE_URL=postgresql://username:password@localhost:5432/kamiboost

# Security Configuration
CSRF_SECRET=your-csrf-secret-here
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# WhatsApp Integration
NEXT_PUBLIC_WHATSAPP_NUMBER=+237123456789

# Feature Flags
NEXT_PUBLIC_ENABLE_REMEMBER_ME=true
NEXT_PUBLIC_ENABLE_PASSWORD_RECOVERY=true
NEXT_PUBLIC_ENABLE_WHATSAPP_WIDGET=true
NEXT_PUBLIC_ENABLE_RATE_LIMITING=true

# Logging and Monitoring
LOG_LEVEL=info
ENABLE_ANALYTICS=false

# Development Configuration
NEXT_PUBLIC_DEV_MODE=true